{
  "name": "DD-API V3 UI (demo)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-8.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "DD-API V3 UI",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "cd ddapiv3ui.client && npm ci --no-audit --no-fund",
  "postAttachCommand": "bash demo/run.sh"
}
